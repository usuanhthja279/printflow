# TEMPLATE ONLY: do not publish these values or deploy before Phase 1 security hardening.
POSTGRES_DB=printflow
POSTGRES_USER=printflow
POSTGRES_PASSWORD=SET_IN_SECRET_MANAGER
# No demo/admin endpoints and NO public enquiry writes in prod Phase 0.
PUBLIC_ENQUIRIES_ENABLED=false
DEMO_ADMIN_KEY=DISABLED

# Required for owner MFA: private base64 32-byte key, stored outside Git.
APP_MFA_ENCRYPTION_KEY=

# Required before enabling native production file storage; dedicated restricted directory.
APP_ARTIFACT_ROOT=/var/lib/jdprintex/private-artifacts
APP_ARTIFACT_SCANNER=CLAMAV
APP_ARTIFACT_SCANNER_PATH=/usr/bin/clamscan

# Local dev only. Copy to .env. Change secrets before any shared deployment.
POSTGRES_DB=printflow
POSTGRES_USER=printflow
POSTGRES_PASSWORD=local-postgres-change-me
DEMO_ADMIN_KEY=local-demo-key-change-this-123456
# DEV ONLY: this permits unauthenticated quote requests in a LOCAL prototype.
PUBLIC_ENQUIRIES_ENABLED=true

# Separate dev/QA-only first owner. Native setup generates credentials privately.
APP_OWNER_BOOTSTRAP_ENABLED=false
APP_OWNER_BOOTSTRAP_USERNAME=
APP_OWNER_BOOTSTRAP_PASSWORD=
# Base64 encoding of 32 random bytes; generated privately by native setup.
# Preserve securely once MFA is enrolled; never commit a real key.
APP_MFA_ENCRYPTION_KEY=

# Customer identity/outbox: local setup generates a separate encryption key.
APP_CUSTOMER_ACCOUNTS_ENABLED=false
APP_MAIL_ENCRYPTION_KEY=
APP_MAIL_ENABLED=false

# Optional owner notification inbox; default is the configured sending account.
# APP_OWNER_NOTIFICATION_EMAIL=owner@jdprintex.in
# Prefer system SPRING_MAIL_USERNAME / SPRING_MAIL_PASSWORD.
APP_MAIL_HOST=smtp.gmail.com
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
# Native DEV sends only to explicitly listed real test recipients, after this activation time.
APP_MAIL_ALLOWED_RECIPIENTS=
APP_MAIL_SEND_AFTER=
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000
APP_PRIVACY_APPROVED=false
APP_TURNSTILE_ENABLED=false
APP_TURNSTILE_SITE_KEY=
APP_TURNSTILE_SECRET=
APP_TURNSTILE_HOSTNAME=jdprintex.in

# Customer Google/Microsoft OIDC: empty credentials keep buttons disabled.
# Configure a separate OAuth app, not Gmail SMTP credentials. Never commit real values.
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_MICROSOFT_CLIENT_ID=
APP_MICROSOFT_CLIENT_SECRET=
APP_MICROSOFT_TENANT_ID=
# Default strict remains for password-only use; configured OIDC requires lax.
APP_SESSION_SAME_SITE=strict

# Private design files (outside public web directories). Windows defaults to native Defender.
APP_ARTIFACT_ROOT=.local/private-artifacts
# Optional overrides: APP_ARTIFACT_SCANNER=DEFENDER|CLAMAV|NONE and APP_ARTIFACT_SCANNER_PATH=absolute executable
# NONE or scan errors keep files quarantined; never configure a fake success command.

# Optional public business contacts shown in live work; do not use private staff addresses.
APP_PUBLIC_SUPPORT_EMAIL=
APP_PUBLIC_SUPPORT_PHONE=

# Official Meta WhatsApp Cloud API. Live delivery stays off until configured and approved.
WHATSAPP_ENABLED=false
APP_WHATSAPP_SIMULATOR_ENABLED=false
APP_WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_PUBLIC_CONTACT_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Verified public business number, digits or +international format. Never use a personal number.
WHATSAPP_PUBLIC_NUMBER=
